{
  "name": "hesocial-platform",
  "version": "1.0.0",
  "description": "High-end social event platform for affluent individuals",
  "main": "backend/dist/server-unified.js",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:worker": "cd backend-rust && cargo build -p hesocial-worker --target wasm32-unknown-unknown --release",
    "build:web-rust": "bash scripts/build-web-rust.sh",
    "preview": "cd frontend && npm run preview",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:frontend:fix": "cd frontend && npm run lint:fix",
    "lint:fix": "npm run lint:frontend:fix",
    "lint:rust": "cd backend-rust && cargo clippy --workspace --target wasm32-unknown-unknown -- -D warnings",
    "typecheck": "npm run typecheck:frontend",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "test": "npm run test:frontend && npm run test:rust",
    "test:frontend": "cd frontend && npm run test",
    "test:rust": "cd backend-rust && cargo test -p core",
    "test:web-rust": "cd frontend-rust && cargo test",
    "test:contract:rust": "cd contract && npm run test",
    "verify:routing": "bash scripts/verify-spa-routing.sh",
    "test:coverage": "npm run test:frontend:coverage",
    "test:frontend:coverage": "cd frontend && npm run test:coverage",
    "setup": "npm install && cd frontend && npm install && cd ../contract && npm install",
    "clean": "npm run clean:frontend",
    "clean:frontend": "cd frontend && rm -rf dist",
    "validate:docs": "node scripts/validate-docs.js",
    "generate:api-docs": "node scripts/generate-api-docs.js",
    "monitor:docs": "node scripts/monitor-docs.js",
    "validate:all": "npm run validate:docs && npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "social",
    "events",
    "luxury",
    "networking",
    "high-end"
  ],
  "author": "HeSocial Platform Team",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "frontend",
    "contract"
  ],
  "dependencies": {
    "@aws-sdk/node-http-handler": "^3.370.0"
  }
}
